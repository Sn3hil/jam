# --- required ---
INVITE_CODE=change-me-long-random
PUBLIC_ORIGIN=http://localhost:3000

# --- api ---
API_TOKEN=change-me-api-token

# --- server ---
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/app.db

# --- limits (DEFAULTs) ---
MAX_QUEUE_PER_USER=5
MAX_TRACK_SECONDS=1200
ENQUEUE_COOLDOWN_MS=2000
SESSION_TTL_DAYS=30
LISTENER_GRACE_MS=12000
STREAM_LEAD_SECONDS=3
PREFETCH_SECONDS=20

# --- binaries ---
YTDLP_PATH=
FFMPEG_PATH=
YTDLP_COOKIES_PATH=
YTDLP_JS_RUNTIME=
YTDLP_EXTRA_ARGS=--extractor-args youtube:player_client=android
